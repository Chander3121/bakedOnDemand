<div id="cart_summary">
  <% total = cart.cart_items.sum { |i| i.quantity * i.product_variant.price } %>

  <div class="bg-white rounded-2xl shadow p-6">

    <h2 class="font-semibold mb-4">Order Summary</h2>

    <div class="flex justify-between mb-2">
      <span>Subtotal</span>
      <span>₹<%= total %></span>
    </div>

    <div class="flex justify-between mb-4">
      <span>Delivery</span>
      <span class="text-green-600">Free</span>
    </div>

    <hr class="mb-4">

    <div class="flex justify-between font-bold text-lg mb-6">
      <span>Total</span>
      <span>₹<%= total %></span>
    </div>

    <!-- 🚀 CHECKOUT BUTTON -->
    <% if cart.cart_items.any? %>
      <% if user_signed_in? %>
        <%= link_to "Proceed to Checkout", new_checkout_path, data: {turbo: false},
          class: "block w-full text-center bg-pink-500 hover:bg-pink-600 text-white py-3 rounded-xl font-semibold transition" %>
      <% else %>
        <%= link_to "Login & Checkout",
          new_user_session_path(checkout: true), data: { turbo: false },
          class: "block w-full text-center bg-pink-500 hover:bg-pink-600 text-white py-3 rounded-xl font-semibold transition" %>

        <%= link_to "Checkout as Guest", new_checkout_path,
          class: "text-sm text-gray-500 underline" %>
      <% end %>
    <% else %>
      <button disabled
        class="w-full bg-gray-300 text-gray-500 py-3 rounded-xl cursor-not-allowed">
        Cart is Empty
      </button>
    <% end %>

  </div>
</div>