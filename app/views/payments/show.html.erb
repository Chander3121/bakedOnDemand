<div class="max-w-6xl mx-auto px-6 py-12 grid md:grid-cols-2 gap-10">

  <!-- 🧾 LEFT: ITEMS + ADDRESS -->
  <div>

    <!-- 🛒 Items -->
    <h2 class="text-xl font-semibold mb-4">Your Items</h2>

    <div class="space-y-4 mb-8">
      <% @order.order_items.each do |item| %>
        <% product = item.product_variant.product %>

        <div class="flex items-center gap-4 bg-white p-4 rounded-xl shadow-sm">

          <div class="w-20 h-20 bg-gray-100 rounded-lg overflow-hidden">
            <% if product.images.attached? %>
              <%= image_tag product.images.first, class: "w-full h-full object-cover" %>
            <% end %>
          </div>

          <div class="flex-1">
            <p class="font-semibold"><%= product.name %></p>
            <p class="text-sm text-gray-500"><%= item.product_variant.size %></p>
            <p class="text-sm">Qty: <%= item.quantity %></p>
          </div>

          <div class="font-semibold text-green-600">
            ₹<%= item.price * item.quantity %>
          </div>

        </div>
      <% end %>
    </div>

    <!-- 📍 Address -->
    <h2 class="text-xl font-semibold mb-3">Delivery Address</h2>

    <div class="bg-white p-4 rounded-xl shadow-sm text-sm text-gray-700">
      <p class="font-semibold"><%= @order.address.name %></p>
      <p><%= @order.address.phone %></p>
      <p><%= @order.address.full_address %></p>
    </div>

  </div>

  <!-- 💰 RIGHT: SUMMARY + PAY -->
  <div>

      <h2 class="text-lg font-semibold mb-4">Order Summary</h2>
    <div class="bg-white p-6 rounded-2xl shadow">


      <% total = @order.total_amount %>

      <div class="flex justify-between mb-2">
        <span>Subtotal</span>
        <span>₹<%= total %></span>
      </div>

      <div class="flex justify-between mb-4">
        <span>Delivery</span>
        <span class="text-green-600">Free</span>
      </div>

      <hr class="mb-4">

      <div class="flex justify-between font-bold text-lg mb-6">
        <span>Total</span>
        <span>₹<%= total %></span>
      </div>

      <!-- 💳 PAY BUTTON -->
      <div
        data-controller="razorpay"
        data-razorpay-key-value="<%= ENV['RAZORPAY_API_KEY'] %>"
        data-razorpay-amount-value="<%= (@order.total_amount * 100).to_i %>"
        data-razorpay-order-id-value="<%= @order.razorpay_order_id %>"
        data-razorpay-order-internal-id-value="<%= @order.id %>"
        data-razorpay-csrf-token-value="<%= form_authenticity_token %>"
      >

        <button
          data-action="click->razorpay#pay"
          class="w-full bg-pink-500 hover:bg-pink-600 text-white py-3 rounded-xl font-semibold">
          Pay Now
        </button>
      </div>

    </div>

  </div>

</div>
