<div class="bg-white rounded-2xl p-6 border border-gray-100 shadow-sm">

  <h2 class="text-lg font-semibold mb-4">My Orders</h2>

  <% if @orders.any? %>
    <div class="space-y-4">
      <% @orders.each do |order| %>
        <% status_class =
          case order.status
          when "pending" then "bg-yellow-100 text-yellow-700"
          when "confirmed" then "bg-blue-100 text-blue-700"
          when "delivered" then "bg-green-100 text-green-700"
          when "cancelled" then "bg-red-100 text-red-700"
          else "bg-gray-100 text-gray-600"
          end %>

        <%= link_to order_path(order),
          class: "block bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition" do %>

          <!-- TOP ROW -->
          <div class="flex justify-between items-start mb-4">

            <div>
              <p class="font-semibold text-gray-800">
                Order #<%= order.id %>
              </p>

              <p class="text-sm text-gray-500">
                <%= order.created_at.strftime("%d %b %Y • %I:%M %p") %>
              </p>
            </div>

            <div class="text-right">
              <p class="text-lg font-bold text-green-600">
                ₹<%= order.total_amount %>
              </p>

              <span class="inline-block mt-1 px-3 py-1 text-xs rounded-full <%= status_class %>">
                <%= order.status.humanize %>
              </span>
            </div>

          </div>

          <!-- 🛒 ITEMS PREVIEW -->
          <div class="flex gap-3 items-center">

            <% order.order_items.limit(3).each do |item| %>
              <% product = item.product_variant.product %>

              <div class="w-14 h-14 bg-gray-100 rounded-lg overflow-hidden">
                <% if product.images.attached? %>
                  <%= image_tag product.images.first,
                      class: "w-full h-full object-cover" %>
                <% end %>
              </div>
            <% end %>

            <% if order.order_items.count > 3 %>
              <div class="text-sm text-gray-400">
                +<%= order.order_items.count - 3 %> more
              </div>
            <% end %>

          </div>

          <!-- ACTION -->
          <div class="mt-4 flex justify-between items-center">

            <p class="text-xs text-gray-400">
              <%= order.order_items.sum(:quantity) %> items
            </p>

            <span class="text-sm text-pink-500 font-medium">
              View Details →
            </span>

          </div>

        <% end %>

      <% end %>
    </div>
  <% else %>
    <!-- EMPTY STATE -->
    <div class="text-center py-16 bg-white rounded-2xl border border-gray-100 shadow-sm">

      <div class="text-5xl mb-4">🧁</div>

      <h2 class="text-lg font-semibold mb-2">
        No orders yet
      </h2>

      <p class="text-gray-500 mb-6">
        Start exploring our delicious bakery items 🍰
      </p>

      <%= link_to "Start Shopping",
          products_path,
          class: "inline-block bg-pink-500 text-white px-6 py-3 rounded-xl hover:bg-pink-600 transition" %>

    </div>
  <% end %>

</div>
