<div class="max-w-7xl mx-auto px-4 py-10">

  <div class="grid md:grid-cols-4 gap-8">

    <!-- 🧭 SIDEBAR -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 h-fit sticky top-24">

      <h2 class="font-semibold mb-4 px-2">My Account</h2>

      <nav class="space-y-1 text-sm">

        <%= link_to "Profile",
          profile_dashboard_path,
          data: { turbo_frame: "dashboard_content" },
          class: sidebar_link("profile") %>

        <%= link_to "Orders",
          orders_dashboard_path,
          data: { turbo_frame: "dashboard_content" },
          class: sidebar_link("orders") %>

        <%= link_to "Addresses",
          addresses_dashboard_path,
          data: { turbo_frame: "dashboard_content" },
          class: sidebar_link("addresses") %>

        <div class="border-t my-2"></div>

        <%= button_to "Logout",
          destroy_user_session_path,
          method: :delete,
          class: "w-full text-left px-3 py-2 rounded-lg text-red-500 hover:bg-red-50" %>

      </nav>

    </div>

    <!-- 📦 CONTENT -->
    <div class="md:col-span-3">

      <%= turbo_frame_tag "dashboard_content" do %>
        <%= render "profile_content" %>
      <% end %>

    </div>

  </div>

</div>
