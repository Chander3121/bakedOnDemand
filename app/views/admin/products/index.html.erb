<h1 class="text-2xl font-bold mb-6 flex justify-between items-center">
  Products

  <%= link_to "Add Product", new_admin_product_path,
    class: "bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm" %>
</h1>

<div class="mb-6 flex justify-between items-center">

  <!-- 🔍 Search -->
  <%= form_with url: admin_products_path,
      method: :get,
      data: { turbo_frame: "products" } do |f| %>
    <div class="relative">
      <%= f.text_field :query,
        id: "searchInput",
        value: params[:query],
        placeholder: "Search products...",
        class: "w-72 pl-10 pr-4 py-2 border rounded-lg" %>

      <%= link_to "Clear", admin_products_path, class: "text-sm text-gray-500 ml-2" %>

      <!-- Icon -->
      <span class="absolute left-3 top-2.5 text-gray-400">🔍</span>
    </div>
  <% end %>

  <!-- Add button already exists -->
</div>

<turbo-frame id="products">
  <%= render "products_grid", products: @products %>
  <%# <div class="text-center text-gray-400 py-10">
    Loading...
  </div> %>
</turbo-frame>

<% if @products.empty? %>
  <div class="text-center text-gray-500 mt-10">
    No products yet. Add your first product 🚀
  </div>
<% end %>

<script>
  document.addEventListener("turbo:load", () => {
    const input = document.getElementById("searchInput")
    if (!input) return

    let timeout = null

    input.addEventListener("input", () => {
      clearTimeout(timeout)

      timeout = setTimeout(() => {
        input.form.requestSubmit()
      }, 500) // ⏱ delay (ms)
    })

    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        clearTimeout(timeout)
        input.form.requestSubmit()
      }
    })

    document.querySelectorAll(".product-card").forEach(card => {

      card.addEventListener("click", (e) => {
        // ❌ prevent click if clicking on buttons/links
        if (e.target.closest("a")) return

        const url = card.dataset.url
        if (url) {
          Turbo.visit(url)
        }
      })

    })
  })
</script>