<h1 class="text-2xl font-bold mb-8 flex justify-between items-center">
  Product Details

  <%= link_to "Back", admin_products_path,
    class: "text-sm text-gray-500 hover:underline" %>
</h1>

<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-6 w-fit">

  <!-- 📝 NAME -->
  <turbo-frame id="product_name">
    <%= render "name_inline", product: @product %>
  </turbo-frame>

  <!-- 📄 DESCRIPTION -->
  <turbo-frame id="product_description">
    <%= render "description_inline", product: @product %>
  </turbo-frame>

  <!-- 🖼️ IMAGES -->
  <turbo-frame id="product_images">
    <%= render "images_inline", product: @product %>
  </turbo-frame>

</div>