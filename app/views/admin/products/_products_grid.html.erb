<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

  <% products.each do |product| %>
    <div class="product-card bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md hover:-translate-y-0.5 transition cursor-pointer"
      data-url="<%= admin_product_path(product) %>">

      <div class="h-44 bg-gray-100 overflow-hidden">
        <% if product.images.attached? %>
          <%= image_tag product.images.first, class: "w-full h-full object-cover" %>
        <% end %>
      </div>

      <div class="p-4">
        <h2 class="font-semibold text-lg"><%= product.name %></h2>
        <p class="text-xs text-gray-500 mb-2"><%= product.category&.name %></p>

        <div class="text-xs text-gray-600">
          <% product.product_variants.limit(2).each do |v| %>
            <div class="flex justify-between">
              <span><%= v.size %></span>
              <span>₹<%= v.price %></span>
            </div>
          <% end %>
        </div>

        <div class="flex justify-between mt-4">
          <%= link_to "Edit", edit_admin_product_path(product), class: "text-blue-600 text-sm" %>
          <%= link_to "Delete", admin_product_path(product), method: :delete, class: "text-red-500 text-sm" %>
        </div>
      </div>

    </div>
  <% end %>

</div>
