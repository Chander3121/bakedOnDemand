<h1 class="text-2xl font-bold mb-6 flex justify-between items-center">
  Categories

  <%= link_to "Add Category", new_admin_category_path,
    class: "bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm" %>
</h1>

<div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:grid-cols-3 lg:grid-cols-4">

  <% @categories.each do |category| %>
    <div class="group block bg-white rounded-2xl shadow-sm border border-gray-100 p-5 hover:shadow-md hover:-translate-y-0.5 transition">

      <!-- 🏷️ Icon -->
      <div class="h-44 overflow-hidden">
        <% if category.image.attached? %>
          <%= image_tag category.image.variant(resize_to_fill: [400, 300]), class: "w-full h-full object-cover group-hover:scale-105 transition duration-300" %>
        <% else %>
          <img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587"
               class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
        <% end %>
      </div>

      <div class="py-4">
        <!-- Name -->
        <h2 class="font-semibold text-lg mb-2">
          <%= category.name %>
        </h2>

        <!-- Meta (optional future use) -->
        <p class="text-xs text-gray-500 mb-4">
          <%= pluralize(category.products.count, "product") %>
        </p>

        <!-- Actions -->
        <div class="flex justify-between items-center">

          <%= link_to "Edit", edit_admin_category_path(category),
            class: "text-sm text-blue-600 hover:underline" %>

          <%= link_to "Delete", admin_category_path(category),
            method: :delete,
            data: { confirm: "Delete this category?" },
            class: "text-sm text-red-500 hover:underline" %>

        </div>
      </div>

    </div>
  <% end %>

  <% if @categories.empty? %>
    <div class="text-center text-gray-500 mt-10">
      No categories yet. Create your first one 🚀
    </div>
  <% end %>

</div>
