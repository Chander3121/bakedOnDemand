<h1 class="text-2xl font-bold mb-6 flex justify-between items-center">
  Categories

  <%= link_to "Add Category", new_admin_category_path,
    class: "bg-pink-500 hover:bg-pink-600 text-white px-4 py-2 rounded-lg text-sm" %>
</h1>

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

  <% @categories.each do |category| %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 hover:shadow-md hover:-translate-y-0.5 transition">

      <!-- 🏷️ Icon -->
      <div class="w-12 h-12 flex items-center justify-center bg-pink-100 text-pink-600 rounded-xl mb-4">
        <%= category.name.include?("Cake") ? "🎂" : "🍪" %>
      </div>

      <!-- Name -->
      <h2 class="font-semibold text-lg mb-2">
        <%= category.name %>
      </h2>

      <!-- Meta (optional future use) -->
      <p class="text-xs text-gray-500 mb-4">
        <%= pluralize(category.products.count, "product") %>
      </p>

      <!-- Actions -->
      <div class="flex justify-between items-center">

        <%= link_to "Edit", edit_admin_category_path(category),
          class: "text-sm text-blue-600 hover:underline" %>

        <%= link_to "Delete", admin_category_path(category),
          method: :delete,
          data: { confirm: "Delete this category?" },
          class: "text-sm text-red-500 hover:underline" %>

      </div>

    </div>
  <% end %>

  <% if @categories.empty? %>
    <div class="text-center text-gray-500 mt-10">
      No categories yet. Create your first one 🚀
    </div>
  <% end %>

</div>
