<%= form_with model: [:admin, @category], local: true do |f| %>

  <div class="space-y-6">

    <div>
      <%= f.label :name, class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name,
        class: "w-full border rounded-lg px-3 py-2",
        placeholder: "e.g. Cakes" %>
    </div>

    <div>
      <%= f.label :image %>
      <%= f.file_field :image %>
    </div>

    <div>
      <%= f.submit class: "bg-pink-500 hover:bg-pink-600 text-white px-5 py-2 rounded-lg" %>
    </div>

  </div>

<% end %>
