<h1 class="text-2xl font-bold mb-6">Orders</h1>

<div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">

  <!-- 📊 Table -->
  <div class="overflow-x-auto">
    <table class="w-full text-sm">

      <!-- 🔝 Header -->
      <thead>
        <tr class="text-left text-gray-500 border-b">

          <th class="py-3">
            <%= link_to "ID",
              admin_orders_path(sort: "id", direction: params[:direction] == "asc" ? "desc" : "asc"),
              class: "hover:text-pink-600" %>
          </th>

          <th class="py-3">Customer</th>

          <th class="py-3">
            <%= link_to "Status",
              admin_orders_path(sort: "status", direction: params[:direction] == "asc" ? "desc" : "asc"),
              class: "hover:text-pink-600" %>
          </th>

          <th class="py-3">
            <%= link_to "Total",
              admin_orders_path(sort: "total_amount", direction: params[:direction] == "asc" ? "desc" : "asc"),
              class: "hover:text-pink-600" %>
          </th>

          <th class="py-3">
            <%= link_to "Date",
              admin_orders_path(sort: "created_at", direction: params[:direction] == "asc" ? "desc" : "asc"),
              class: "hover:text-pink-600" %>
          </th>

          <th class="py-3 text-right">Actions</th>
        </tr>
      </thead>

      <!-- 📦 Body -->
      <tbody>
        <% @orders.each do |order| %>
          <tr class="border-b hover:bg-gray-50 transition">

            <!-- ID -->
            <td class="py-3 font-medium">
              #<%= order.id %>
            </td>

            <!-- Customer -->
            <td class="py-3">
              <p class="font-medium"><%= order.name %></p>
              <p class="text-xs text-gray-500"><%= order.phone %></p>
            </td>

            <!-- Status -->
            <td class="py-3">
              <% status_class =
                case order.status
                when "pending" then "bg-yellow-100 text-yellow-700"
                when "confirmed" then "bg-blue-100 text-blue-700"
                when "out_for_delivery" then "bg-purple-100 text-purple-700"
                when "delivered" then "bg-green-100 text-green-700"
                when "cancelled" then "bg-red-100 text-red-700"
                end %>

              <span class="px-3 py-1 rounded-full text-xs font-medium <%= status_class %>">
                <%= order.status.humanize %>
              </span>
            </td>

            <!-- Total -->
            <td class="py-3 font-semibold text-green-600">
              ₹<%= order.total_amount %>
            </td>

            <!-- Date -->
            <td class="py-3 text-gray-500">
              <%= order.created_at.strftime("%d %b %Y") %>
            </td>

            <!-- Actions -->
            <td class="py-3 text-right">
              <%= link_to "View",
                admin_order_path(order),
                class: "text-sm text-pink-600 hover:underline" %>
            </td>

          </tr>
        <% end %>
      </tbody>

    </table>
  </div>

  <!-- 📄 Pagination -->
  <div class="mt-6 flex justify-center">
	  <%= paginate @orders %>
	</div>

</div>
