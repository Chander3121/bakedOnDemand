<div class="space-y-10">
  <h1 class="text-2xl font-bold mb-6">Dashboard</h1>

  <!-- 🔍 Search + Filters -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">

    <%= form_with url: admin_root_path, method: :get, class: "flex gap-2" do %>
      <input type="text" name="q" placeholder="Search orders..."
        class="border rounded-lg px-3 py-2 text-sm">

      <button class="bg-gray-800 text-white px-4 py-2 rounded-lg text-sm">
        Search
      </button>
    <% end %>

    <div class="flex gap-2 text-sm">
      <%= link_to "Today", admin_root_path(range: "today"), class: "px-3 py-1 bg-gray-200 rounded" %>
      <%= link_to "Week", admin_root_path(range: "week"), class: "px-3 py-1 bg-gray-200 rounded" %>
      <%= link_to "Month", admin_root_path(range: "month"), class: "px-3 py-1 bg-gray-200 rounded" %>
    </div>

  </div>

  <!-- 🔢 Stats -->
  <div class="grid md:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 hover:-translate-y-0.5">
      <p class="text-sm text-gray-500">Orders</p>
      <h2 class="text-2xl font-bold"><%= @orders %></h2>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 hover:-translate-y-0.5">
      <p class="text-sm text-gray-500">Revenue</p>
      <h2 class="text-2xl font-bold">₹<%= @revenue %></h2>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 hover:-translate-y-0.5">
      <p class="text-sm text-gray-500">Products</p>
      <h2 class="text-2xl font-bold"><%= @products %></h2>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm hover:shadow-md transition border border-gray-100 hover:-translate-y-0.5">
      <p class="text-sm text-gray-500">Users</p>
      <h2 class="text-2xl font-bold"><%= @users %></h2>
    </div>
  </div>

  <!-- 📦 Recent Orders -->
  <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
    <div class="flex justify-between items-center mb-5">
      <h2 class="font-semibold text-lg">Recent Orders</h2>

      <%= link_to "View all", admin_orders_path,
        class: "text-sm text-pink-500 hover:underline" %>
    </div>

    <div class="overflow-hidden rounded-xl border border-gray-100">
      <table class="w-full text-sm">
        <!-- Header -->
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
          <tr>
            <th class="px-4 py-3 text-left">Order</th>
            <th class="px-4 py-3 text-left">Customer</th>
            <th class="px-4 py-3 text-left">Status</th>
            <th class="px-4 py-3 text-center">Date</th>
            <th class="px-4 py-3 text-right">Total</th>
          </tr>
        </thead>

        <!-- Body -->
        <tbody class="divide-y">

          <% @recent_orders.each do |order| %>

            <% status_class =
              case order.status
              when "pending" then "bg-yellow-100 text-yellow-700"
              when "confirmed" then "bg-blue-100 text-blue-700"
              when "out_for_delivery" then "bg-purple-100 text-purple-700"
              when "delivered" then "bg-green-100 text-green-700"
              when "cancelled" then "bg-red-100 text-red-700"
              end %>

            <tr class="hover:bg-gray-50 transition cursor-pointer"
                onclick="window.location='<%= admin_order_path(order) %>'">

              <!-- Order ID -->
              <td class="px-4 py-4 font-medium text-gray-800">
                #<%= order.id %>
              </td>

              <!-- Customer -->
              <td class="px-4 py-4">
                <p class="font-medium"><%= order.name %></p>
                <p class="text-xs text-gray-400">Customer</p>
              </td>

              <!-- Status -->
              <td class="px-4 py-4">
                <span class="px-3 py-1 rounded-full text-xs font-medium <%= status_class %>">
                  <%= order.status.humanize %>
                </span>
              </td>

              <!-- Date -->
              <td class="px-4 py-4 text-center">
                <p class="text-xs text-gray-400">
                  <%= order.created_at.strftime("%d %B %Y") %>
                </p>
              </td>

              <!-- Total -->
              <td class="px-4 py-4 text-right font-semibold text-green-600">
                ₹<%= order.total_amount %>
              </td>

            </tr>

          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 📊 Charts -->
  <div class="grid md:grid-cols-2 gap-8 mb-10">

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <h2 class="font-semibold mb-4">Orders Trend</h2>
      <% if @orders_by_day.present? %>
        <%= line_chart @orders_by_day %>
      <% else %>
        <!-- Skeleton -->
        <div class="animate-pulse space-y-3">
          <div class="h-4 bg-gray-200 rounded w-1/3"></div>
          <div class="h-40 bg-gray-200 rounded"></div>
        </div>
      <% end %>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <h2 class="font-semibold mb-4">Revenue Trend</h2>
      <% if @revenue_by_day.present? %>
        <%= line_chart @revenue_by_day %>
      <% else %>
        <!-- Skeleton -->
        <div class="animate-pulse space-y-3">
          <div class="h-4 bg-gray-200 rounded w-1/3"></div>
          <div class="h-40 bg-gray-200 rounded"></div>
        </div>
      <% end %>
    </div>

  </div>

  <!-- 🥇 Top Products -->
  <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
    <h2 class="font-semibold mb-4">Top Products</h2>
    <% if @top_products.present? %>
      <%= column_chart @top_products %>
    <% else %>
        <!-- Skeleton -->
        <div class="animate-pulse space-y-3">
          <div class="h-4 bg-gray-200 rounded w-1/3"></div>
          <div class="h-40 bg-gray-200 rounded"></div>
        </div>
      <% end %>
  </div>
</div>
