<%= turbo_stream.append "flash", partial: "layouts/toast", locals: { message: "Added to cart" } %>

<%= turbo_stream.replace "cart_count" do %>
  <span id="cart_count"
        class="absolute -top-2 -right-2 bg-pink-500 text-white text-xs px-1.5 rounded-full">
    <%= cart_count %>
  </span>
<% end %>