<nav class="flex items-center justify-center gap-2 mt-6">

  <!-- 🔙 Prev -->
  <% if current_page > 1 %>
    <%= link_to "Prev", url_for(page: current_page - 1),
      class: "px-4 py-1.5 text-sm rounded-lg bg-gray-100 hover:bg-gray-200 transition hover:-translate-y-0.5 transition" %>
  <% else %>
    <span class="px-4 py-1.5 text-sm rounded-lg bg-gray-100 text-gray-400 cursor-not-allowed">
      Prev
    </span>
  <% end %>

  <!-- 🔢 Pages -->
  <% paginator.each_page do |page| %>
    <% if page.current? %>
      <span class="px-3 py-1.5 text-sm rounded-lg bg-pink-500 text-white font-medium shadow-sm hover:-translate-y-0.5 transition">
        <%= page %>
      </span>
    <% else %>
      <%= link_to page, url_for(page: page),
        class: "px-3 py-1.5 text-sm rounded-lg bg-gray-100 hover:bg-pink-100 transition hover:-translate-y-0.5 transition" %>
    <% end %>
  <% end %>

  <!-- 🔜 Next -->
  <% if current_page < total_pages %>
    <%= link_to "Next", url_for(page: current_page + 1),
      class: "px-4 py-1.5 text-sm rounded-lg bg-gray-100 hover:bg-gray-200 transition hover:-translate-y-0.5 transition" %>
  <% else %>
    <span class="px-4 py-1.5 text-sm rounded-lg bg-gray-100 text-gray-400 cursor-not-allowed">
      Next
    </span>
  <% end %>

</nav>