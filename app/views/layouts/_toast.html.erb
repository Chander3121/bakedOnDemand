<div data-controller="toast"
     data-toast-target="toast"
     class="fixed top-20 right-6 z-50
            bg-white/80 backdrop-blur-xl
            text-gray-800 px-5 py-3 rounded-xl
            shadow-xl border border-white/40
            flex items-center gap-3
            transform translate-y-5 opacity-0 scale-95
            transition-all duration-300 ease-out">

  <!-- ✅ Icon -->
  <div class="w-8 h-8 flex items-center justify-center rounded-full bg-green-100">
    <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" stroke-width="3"
         viewBox="0 0 24 24">
      <path d="M5 13l4 4L19 7"/>
    </svg>
  </div>

  <!-- 💬 Message -->
  <span class="text-sm font-medium">
    <%= message %>
  </span>

</div>
