<div data-controller="ai-chat">

  <!-- 💬 Floating Button -->
  <button
    data-action="click->ai-chat#toggle"
    class="fixed bottom-6 right-6 z-50
           w-16 h-16 rounded-full
           bg-gradient-to-br from-pink-500 to-rose-500
           text-white shadow-2xl
           flex items-center justify-center
           hover:scale-110 transition duration-300">

    <span class="text-2xl">🤖</span>

  </button>

  <!-- 🪟 Chat Window -->
  <div
    data-ai-chat-target="window"
    class="hidden fixed bottom-24 right-6 z-50
           w-[380px] h-[600px]
           rounded-3xl overflow-hidden
           shadow-2xl border border-white/20
           bg-white/80 backdrop-blur-2xl">

    <!-- HEADER -->
    <div class="bg-gradient-to-r from-pink-500 to-rose-500
                text-white p-5 flex items-center gap-3">

      <div class="w-10 h-10 rounded-full bg-white/20
                  flex items-center justify-center text-xl">
        🤖
      </div>

      <div>
        <h3 class="font-semibold">
          Bakery AI Assistant
        </h3>

        <p class="text-xs text-pink-100">
          Ask me for cake recommendations ✨
        </p>
      </div>

    </div>

    <!-- MESSAGES -->
    <div class="messages flex-1 h-[430px] overflow-y-auto p-4 space-y-4 bg-[#fffaf7]">

      <!-- AI MESSAGE -->
      <div class="flex gap-2">

        <div class="w-8 h-8 rounded-full bg-pink-500 text-white
                    flex items-center justify-center text-sm">
          AI
        </div>

        <div class="bg-white p-3 rounded-2xl rounded-tl-sm
                    shadow-sm max-w-[80%]">

          👋 Hi! Tell me what kind of cake you're looking for.

        </div>

      </div>

    </div>

    <!-- INPUT -->
    <div class="p-4 bg-white border-t">

      <form
        data-action="submit->ai-chat#sendMessage"
        class="flex items-center gap-2">

        <input
          type="text"
          placeholder="Ask for cakes..."
          data-ai-chat-target="input"
          class="flex-1 border border-gray-200
                 rounded-full px-4 py-3
                 focus:outline-none focus:ring-2
                 focus:ring-pink-400">

        <button
          type="submit"
          class="bg-pink-500 hover:bg-pink-600
                 text-white px-5 py-3 rounded-full
                 font-medium transition">

          Send

        </button>

      </form>

    </div>

  </div>

</div>
