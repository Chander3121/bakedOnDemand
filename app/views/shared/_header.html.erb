<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">

    <!-- 🧁 Logo -->
    <%= link_to '/', class: "flex items-center gap-2" do%>
      <span class="text-2xl">🍰</span>
      <h1 class="text-xl font-bold text-pink-600">BakesOnDemand</h1>
    <% end %>

    <!-- 🔍 Search -->
    <div class="hidden md:flex items-center bg-gray-100 px-3 py-2 rounded-xl w-1/3">
      <input type="text" placeholder="Search cakes, pastries..."
        class="bg-transparent outline-none w-full text-sm">
    </div>

    <!-- 🔗 Nav Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <%= link_to "Home", root_path, class: "hover:text-pink-500" %>
      <%= link_to "Cakes", cakes_path, class: "hover:text-pink-500" %>
      <%= link_to "Pastries", pastries_path, class: "hover:text-pink-500" %>
      <%= link_to "Orders", "#", class: "hover:text-pink-500" %>
    </nav>

    <!-- 🛒 Actions -->
    <div class="flex items-center gap-4">

      <!-- Cart -->
      <%= link_to cart_path, class: "relative" do %>
        🛒
        <% if cart_count > 0 %>
          <span id="cart_count" class="absolute -top-2 -right-2 bg-pink-500 text-white text-xs px-1.5 rounded-full">
            <%= cart_count %>
          </span>
        <% end %>
      <% end %>

      <!-- Profile -->
      <%= link_to "#", class: "text-sm hover:text-pink-500" do %>
        👤
      <% end %>

    </div>

  </div>
</header>