<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">

    <!-- 🧁 Logo -->
    <%= link_to '/', class: "flex items-center gap-2" do%>
      <span class="text-2xl">🍰</span>
      <h1 class="text-xl font-bold text-pink-600">BakesOnDemand</h1>
    <% end %>

    <!-- 🔍 Search -->
    <div class="hidden md:flex items-center bg-gray-100 px-3 py-2 rounded-xl w-1/3">
      <%= form_with url: products_path,
          method: :get,
          data: { turbo_frame: "products" },
          class: "w-full" do |f| %>

        <%= f.text_field :query,
          id: "globalSearch",
          value: params[:query],
          placeholder: "Search cakes, pastries...",
          class: "bg-transparent outline-none w-full text-sm" %>

      <% end %>
      <span class="mr-2 text-gray-400">🔍</span>
    </div>

    <!-- 🔗 Nav Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
      <%= link_to "Home", root_path, class: "hover:text-pink-500" %>
      <%= link_to "Cakes", products_path(category_id: 1), class: "hover:text-pink-500" %>
      <%= link_to "Pastries", products_path(category_id: 2), class: "hover:text-pink-500" %>
      <% if user_signed_in? %>
        <%= link_to "Orders", orders_path, class: "hover:text-pink-500" %>
      <% end %>
    </nav>

    <!-- 🛒 Actions -->
    <div class="flex items-center gap-6">

      <!-- 🛒 Cart -->
      <%= link_to cart_path, class: "relative group" do %>
        <svg xmlns="http://www.w3.org/2000/svg"
             class="w-6 h-6 text-gray-700 group-hover:text-pink-500 transition"
             fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.5 7h13M7 13L5.4 5" />
        </svg>

        <%# if cart_count > 0 %>
          <span class="absolute -top-2 -right-2 bg-pink-500 text-white text-xs px-1.5 rounded-full transition-transform duration-200" id="cart_count">
            <%= cart_count %>
          </span>
        <%# end %>
      <% end %>

      <% if user_signed_in? %>
        <!-- 👤 Profile Dropdown -->
        <div data-controller="dropdown" class="relative">

          <!-- Avatar -->
          <button data-action="click->dropdown#toggle"
            class="w-9 h-9 rounded-full bg-pink-100 flex items-center justify-center
                   hover:bg-pink-200 transition ease-out duration-200">

            <span class="text-sm font-semibold text-pink-600">
              <%= current_user.email.first.upcase %>
            </span>

          </button>

          <!-- Dropdown Menu -->
          <div data-dropdown-target="menu"
             class="hidden absolute right-0 mt-3 w-64 rounded-2xl
                      bg-white/70 backdrop-blur-xl
                      shadow-xl ring-1 ring-black/10
                      overflow-hidden
                      transition ease-out duration-200 origin-top-right">

            <!-- 👤 USER INFO -->
            <div class="px-4 py-3 border-b border-white/40">
              <p class="text-sm font-semibold text-gray-800 truncate">
                <%= current_user.email %>
              </p>
              <p class="text-xs text-gray-500">
                Welcome back 👋
              </p>
            </div>

            <!-- 📦 Orders -->
            <%= link_to orders_path,
              class: "flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-white/50 transition" do %>

              <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2"
                   viewBox="0 0 24 24">
                <path d="M20 13V7a2 2 0 00-2-2h-3V3H9v2H6a2 2 0 00-2 2v6m16 0l-8 4-8-4"/>
              </svg>

              My Orders

            <% end %>

            <!-- 👤 Profile -->
            <%= link_to dashboard_path,
              class: "flex items-center gap-3 px-4 py-3 text-sm text-gray-700 hover:bg-white/50 transition" do %>

              <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" stroke-width="2"
                   viewBox="0 0 24 24">
                <path d="M5.121 17.804A9 9 0 1118.879 17.804M15 11a3 3 0 11-6 0"/>
              </svg>

              My Dashboard

            <% end %>

            <div class="border-t border-white/40 my-1"></div>

            <!-- 🚪 Logout -->
            <%= button_to destroy_user_session_path,
              method: :delete,
              class: "w-full flex items-center gap-3 px-4 py-3 text-sm text-red-500 hover:bg-red-50/70 transition" do %>

              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2"
                   viewBox="0 0 24 24">
                <path d="M17 16l4-4m0 0l-4-4m4 4H7"/>
              </svg>

              Logout

            <% end %>

          </div>

        </div>

      <% else %>

        <%= link_to "Login",
          new_user_session_path,
          class: "text-sm font-medium hover:text-pink-500 transition" %>

      <% end %>

    </div>

  </div>
</header>