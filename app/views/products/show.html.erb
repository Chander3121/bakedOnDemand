<div class="max-w-6xl mx-auto px-4 py-10">

  <div class="grid md:grid-cols-2 gap-12">

    <!-- 🖼️ Image Section -->
    <div>
      <div class="bg-gray-100 rounded-2xl overflow-hidden h-[420px] mb-4">
        <% if @product.images.attached? %>
          <%= image_tag @product.images.first,
            id: "mainImage",
            class: "w-full h-full object-cover transition duration-300" %>
        <% else %>
          <div class="flex items-center justify-center h-full text-gray-400">
            No Image
          </div>
        <% end %>
      </div>

      <!-- Thumbnails -->
      <div class="flex gap-3">
        <% @product.images.each_with_index do |img, index| %>
          <%= image_tag img,
            class: "thumbnail w-20 h-20 object-cover rounded-lg cursor-pointer border hover:border-pink-500 #{'border-pink-500' if index == 0}",
            data: { full: url_for(img) } %>
        <% end %>
      </div>
    </div>

    <!-- 📦 Details Section -->
    <div>

      <!-- Title -->
      <h1 class="text-3xl font-bold mb-2"><%= @product.name %></h1>
      <div class="flex items-center gap-3 mb-3">

        <!-- ⭐ Rating Pill -->
        <div class="flex items-center gap-1 bg-green-600 text-white px-3 py-1 rounded-full font-semibold text-sm shadow-sm">

          <span>
            <%= number_with_precision(@product.average_rating, precision: 1) %>
          </span>

          <span class="text-xs">★</span>

        </div>

        <!-- 📝 Reviews Count -->
        <span class="text-gray-500 font-medium">
          <%= format_count(@product.reviews.count) %> Reviews
        </span>

      </div>

      <!-- Tags -->
      <div class="flex gap-2 mb-4">
        <% @product.tags.each do |tag| %>
          <span class="bg-pink-100 text-pink-600 text-xs px-3 py-1 rounded-full">
            <%= tag.name %>
          </span>
        <% end %>
      </div>

      <!-- Description -->
      <p class="text-gray-600 mb-6"><%= @product.description %></p>

      <% default_variant = @product.product_variants.first %>

      <!-- Price -->
      <div class="mb-6">
        <p class="text-3xl font-bold text-green-600">
          ₹<span id="price"><%= default_variant.price %></span>
        </p>
      </div>

      <!-- Variant Selection -->
      <div class="mb-6">
        <p class="font-semibold mb-3">Select Size:</p>

        <div class="flex flex-wrap gap-3">
          <% first_available = @product.product_variants.find { |v| v.stock > 0 } %>

          <% @product.product_variants.each do |variant| %>
            <%= turbo_stream_from "product_variant_#{variant.id}" %>

            <label>
              <input type="radio"
                     name="variant"
                     value="<%= variant.id %>"
                     data-price="<%= variant.price %>"
                     data-stock="<%= variant.stock %>"
                     class="hidden variant-radio"
                     <%= "checked" if variant == first_available %>
                     <%= "disabled" if variant.stock == 0 %>>

              <div class="variant-box px-4 py-2 border rounded-xl cursor-pointer transition hover:border-pink-500
                <%= 'opacity-50 pointer-events-none' if variant.stock == 0 %>">

                <p class="text-sm font-medium"><%= variant.size %></p>
                <p class="text-xs text-gray-500">₹<%= variant.price %></p>

                <% if variant.stock == 0 %>
                  <p class="text-xs text-red-500">Out of stock</p>
                <% end %>

              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Quantity + Add -->
      <div class="mb-6">
        <p class="font-semibold mb-2">Quantity:</p>

        <%= form_with url: cart_items_path, method: :post,
            data: { turbo_stream: true } do %>

          <input type="hidden" name="product_variant_id" id="selected_variant" value="<%= default_variant.id %>">
          <input type="hidden" name="quantity" id="final_quantity" value="1">

          <div class="flex items-center gap-4">

            <div class="flex items-center gap-3">
              <button type="button" onclick="decreaseQty()"
                class="w-10 h-10 bg-gray-200 rounded-full text-lg">−</button>

              <input type="text" id="quantity" value="1"
                class="w-12 text-center border rounded-lg py-1">

              <button type="button" onclick="increaseQty()"
                class="w-10 h-10 bg-gray-200 rounded-full text-lg">+</button>
            </div>

            <button type="submit"
              id="addToCartBtn"
              class="flex-1 bg-pink-500 hover:bg-pink-600 text-white py-3 rounded-xl font-semibold transition">
              Add to Cart
            </button>
          </div>

        <% end %>

        <p id="stockInfo" class="text-sm text-gray-500 mt-2"></p>
      </div>
    </div>
  </div>
</div>

<!-- ⭐ REVIEWS SECTION -->
<div class="max-w-6xl mx-auto px-4 pb-16">

  <!-- ⭐ Leave Review -->
  <div class="bg-white p-6 rounded-2xl shadow-sm mt-10">

    <h3 class="font-semibold mb-4">Leave a Review</h3>

    <% if user_signed_in? %>

      <%= form_with model: [@product, Review.new], local: true do |f| %>

        <!-- ⭐ Stars -->
        <div class="flex gap-2 mb-4">
          <% (1..5).each do |i| %>
            <label>
              <%= f.radio_button :rating, i, class: "hidden peer" %>
              <span class="text-2xl cursor-pointer peer-checked:text-yellow-400 text-gray-300 hover:text-yellow-400 transition">
                ★
              </span>
            </label>
          <% end %>
        </div>

        <!-- 💬 Comment -->
        <%= f.text_area :comment,
          placeholder: "Write your review...",
          class: "w-full border rounded-xl p-3 mb-4" %>

        <%= f.submit "Submit Review",
          class: "bg-pink-500 text-white px-4 py-2 rounded-xl hover:bg-pink-600" %>

      <% end %>

    <% else %>

      <%= link_to "Login to review",
        new_user_session_path,
        class: "text-pink-500 underline" %>

    <% end %>

  </div>

  <!-- 💬 Reviews List -->
  <div class="mt-10 space-y-4">

    <h3 class="font-semibold">Customer Reviews</h3>

    <% if @product.reviews.any? %>

      <% @product.reviews.each do |review| %>

        <div class="bg-white p-4 rounded-xl shadow-sm border">

          <div class="text-yellow-400 text-lg">
            <%= "★" * review.rating %><%= "☆" * (5 - review.rating) %>
          </div>

          <p class="text-sm text-gray-600 mt-1">
            <%= review.comment %>
          </p>

          <p class="text-xs text-gray-400 mt-2">
            — <%= review.user.email %>
          </p>

        </div>

      <% end %>

    <% else %>

      <p class="text-gray-400">No reviews yet. Be the first!</p>

    <% end %>

  </div>

</div>

<!-- ⚡ JS -->
<script>
document.addEventListener("turbo:load", () => {

  // 🔥 IMAGE SWITCHING
  const thumbnails = document.querySelectorAll(".thumbnail")
  const mainImage = document.getElementById("mainImage")

  thumbnails.forEach(img => {
    img.addEventListener("click", () => {

      if (mainImage) {
        mainImage.src = img.dataset.full
      }

      // highlight active
      thumbnails.forEach(el => el.classList.remove("border-pink-500"))
      img.classList.add("border-pink-500")
    })
  })

  // 🔥 VARIANT + STOCK LOGIC
  const radios = document.querySelectorAll('.variant-radio')
  const priceEl = document.getElementById("price")
  const hiddenInput = document.getElementById("selected_variant")
  const stockInfo = document.getElementById("stockInfo")
  const addBtn = document.getElementById("addToCartBtn")
  const qtyInput = document.getElementById("quantity")
  const hiddenQty = document.getElementById("final_quantity")

  let currentStock = 0

  function updateUI(radio) {
    if (!radio) return

    const stock = parseInt(radio.dataset.stock)
    currentStock = stock

    if (priceEl) priceEl.innerText = radio.dataset.price
    if (hiddenInput) hiddenInput.value = radio.value

    if (stockInfo) {
      if (stock === 0) {
        stockInfo.innerText = "Out of stock"
      } else if (stock <= 3) {
        stockInfo.innerText = `Only ${stock} left 🔥`
        stockInfo.classList.add("text-red-500")
      } else {
        stockInfo.innerText = `Stock available: ${stock}`
        stockInfo.classList.remove("text-red-500")
      }
    }

    if (addBtn) {
      if (stock > 0) {
        addBtn.disabled = false
        addBtn.classList.remove("bg-gray-300", "cursor-not-allowed")
        addBtn.classList.add("bg-pink-500")
      } else {
        addBtn.disabled = true
        addBtn.classList.remove("bg-pink-500")
        addBtn.classList.add("bg-gray-300", "cursor-not-allowed")
      }
    }

    if (qtyInput && hiddenQty) {
      if (parseInt(qtyInput.value) > stock) {
        qtyInput.value = stock || 1
        hiddenQty.value = qtyInput.value
      }
    }
  }

  radios.forEach(radio => {
    radio.addEventListener("change", () => updateUI(radio))
  })

  // 🔥 Quantity
  window.increaseQty = function () {
    let value = parseInt(qtyInput.value) || 1
    if (value < currentStock) {
      qtyInput.value = value + 1
      hiddenQty.value = qtyInput.value
    }
  }

  window.decreaseQty = function () {
    let value = parseInt(qtyInput.value) || 1
    if (value > 1) {
      qtyInput.value = value - 1
      hiddenQty.value = qtyInput.value
    }
  }

  // Initial
  const selected = document.querySelector('.variant-radio:checked')
  updateUI(selected)

})
</script>
