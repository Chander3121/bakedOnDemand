<div class="max-w-6xl mx-auto px-4 py-10">

  <div class="grid md:grid-cols-2 gap-12">

    <!-- 🖼️ Image Section -->
    <div>
      <div class="bg-gray-100 rounded-2xl overflow-hidden h-[420px] mb-4">
        <% if @product.images.attached? %>
          <%= image_tag @product.images.first, id: "mainImage", class: "w-full h-full object-cover transition duration-300" %>
        <% else %>
          <div class="flex items-center justify-center h-full text-gray-400">
            No Image
          </div>
        <% end %>
      </div>

      <!-- Thumbnails -->
      <div class="flex gap-3">
        <% @product.images.each do |img| %>
          <%= image_tag img,
            class: "w-20 h-20 object-cover rounded-lg cursor-pointer border hover:border-pink-500",
            onclick: "changeImage(this.src)" %>
        <% end %>
      </div>
    </div>

    <!-- 📦 Details Section -->
    <div>

      <!-- Title -->
      <h1 class="text-3xl font-bold mb-2"><%= @product.name %></h1>

      <!-- Tags -->
      <div class="flex gap-2 mb-4">
        <% @product.tags.each do |tag| %>
          <span class="bg-pink-100 text-pink-600 text-xs px-3 py-1 rounded-full">
            <%= tag.name %>
          </span>
        <% end %>
      </div>

      <!-- Description -->
      <p class="text-gray-600 mb-6"><%= @product.description %></p>

      <% default_variant = @product.product_variants.first %>

      <!-- Price -->
      <div class="mb-6">
        <p class="text-3xl font-bold text-green-600">
          ₹<span id="price"><%= default_variant.price %></span>
        </p>
      </div>

      <!-- Variant Selection -->
      <div class="mb-6">
        <p class="font-semibold mb-3">Select Size:</p>

        <div class="flex flex-wrap gap-3">
          <% first_available = @product.product_variants.find { |v| v.stock > 0 } %>
          <% @product.product_variants.each do |variant| %>
            <%= turbo_stream_from "product_variant_#{variant.id}" %>
            <label>
              <input type="radio"
                     name="variant"
                     value="<%= variant.id %>"
                     data-price="<%= variant.price %>"
                     data-stock="<%= variant.stock %>"
                     class="hidden variant-radio"
                     <%= "checked" if variant == first_available %>
                     <%= "disabled" if variant.stock == 0 %>>

              <div class="variant-box px-4 py-2 border rounded-xl cursor-pointer transition hover:border-pink-500
                <%= 'opacity-50 pointer-events-none' if variant.stock == 0 %>">

                <p class="text-sm font-medium"><%= variant.size %></p>
                <p class="text-xs text-gray-500">₹<%= variant.price %></p>

                <% if variant.stock == 0 %>
                  <p class="text-xs text-red-500">Out of stock</p>
                <% end %>

              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Quantity + Add -->
      <div class="mb-6">
        <p class="font-semibold mb-2">Quantity:</p>

        <%= form_with url: cart_items_path, method: :post,
            data: { turbo_stream: true } do %>

          <!-- Hidden fields -->
          <input type="hidden" name="product_variant_id" id="selected_variant" value="<%= default_variant.id %>">
          <input type="hidden" name="quantity" id="final_quantity" value="1">

          <div class="flex items-center gap-4">

            <!-- Quantity controls -->
            <div class="flex items-center gap-3">
              <button type="button" onclick="decreaseQty()"
                class="w-10 h-10 bg-gray-200 rounded-full text-lg">−</button>

              <input type="text" id="quantity" value="1"
                class="w-12 text-center border rounded-lg py-1">

              <button type="button" onclick="increaseQty()"
                class="w-10 h-10 bg-gray-200 rounded-full text-lg">+</button>
            </div>

            <!-- Add button -->
            <button type="submit"
              id="addToCartBtn"
              class="flex-1 bg-pink-500 hover:bg-pink-600 text-white py-3 rounded-xl font-semibold transition">
              Add to Cart
            </button>
          </div>

        <% end %>

        <p id="stockInfo" class="text-sm text-gray-500 mt-2"></p>
      </div>
    </div>
  </div>
</div>

<!-- ⚡ JS -->
<script>
document.addEventListener("turbo:load", () => {

  const radios = document.querySelectorAll('.variant-radio')
  const priceEl = document.getElementById("price")
  const hiddenInput = document.getElementById("selected_variant")
  const stockInfo = document.getElementById("stockInfo")
  const addBtn = document.getElementById("addToCartBtn")
  const qtyInput = document.getElementById("quantity")
  const hiddenQty = document.getElementById("final_quantity")

  let currentStock = 0

  function updateUI(radio) {
    if (!radio) return

    const stock = parseInt(radio.dataset.stock)
    currentStock = stock

    if (priceEl) priceEl.innerText = radio.dataset.price
    if (hiddenInput) hiddenInput.value = radio.value

    // 🔥 Stock messaging
    if (stockInfo) {
      if (stock === 0) {
        stockInfo.innerText = "Out of stock"
      } else if (stock <= 3) {
        stockInfo.innerText = `Only ${stock} left 🔥`
        stockInfo.classList.add("text-red-500")
      } else {
        stockInfo.innerText = `Stock available: ${stock}`
        stockInfo.classList.remove("text-red-500")
      }
    }

    // Disable button
    if (addBtn) {
      if (stock > 0) {
        addBtn.disabled = false
        addBtn.classList.remove("bg-gray-300", "cursor-not-allowed")
        addBtn.classList.add("bg-pink-500")
      } else {
        addBtn.disabled = true
        addBtn.classList.remove("bg-pink-500")
        addBtn.classList.add("bg-gray-300", "cursor-not-allowed")
      }
    }

    // Reset quantity if exceeds stock
    if (qtyInput && hiddenQty) {
      if (parseInt(qtyInput.value) > stock) {
        qtyInput.value = stock || 1
        hiddenQty.value = qtyInput.value
      }
    }
  }

  radios.forEach(radio => {
    radio.addEventListener("change", () => updateUI(radio))
  })

  // 🔥 Quantity controls with stock limit
  window.increaseQty = function () {
    let value = parseInt(qtyInput.value) || 1

    if (value < currentStock) {
      qtyInput.value = value + 1
      hiddenQty.value = qtyInput.value
    }
  }

  window.decreaseQty = function () {
    let value = parseInt(qtyInput.value) || 1
    if (value > 1) {
      qtyInput.value = value - 1
      hiddenQty.value = qtyInput.value
    }
  }

  // Initial load
  const selected = document.querySelector('.variant-radio:checked')
  updateUI(selected)

})
</script>