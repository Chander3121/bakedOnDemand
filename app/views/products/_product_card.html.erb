<div class="bg-white rounded-2xl shadow hover:shadow-lg transition duration-300 overflow-hidden">
  <!-- 🖼️ Image -->
  <div class="h-48 bg-gray-100 overflow-hidden">
    <% if product.images.attached? %>
      <%= image_tag product.images.first, class: "w-full h-full object-cover hover:scale-105 transition duration-300" %>
    <% else %>
      <div class="flex items-center justify-center h-full text-gray-400">
        No Image
      </div>
    <% end %>
  </div>

  <!-- 📦 Content -->
  <div class="p-4">
    
    <!-- Name -->
    <h2 class="text-lg font-semibold mb-1">
      <%= product.name %>
    </h2>

    <!-- Description -->
    <p class="text-sm text-gray-500 mb-2 line-clamp-2">
      <%= product.description %>
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 mb-3">
      <% product.tags.each do |tag| %>
        <span class="text-xs bg-pink-100 text-pink-600 px-2 py-1 rounded-full">
          <%= tag.name %>
        </span>
      <% end %>
    </div>

    <div class="flex items-center justify-between my-3">
      <!-- 💰 Price -->
      <% if product.product_variants.any? %>
        <% min_price = product.product_variants.minimum(:price) %>

        <div class="flex flex-col">
          <p class="text-green-600 font-bold text-xl leading-none">
            ₹<%= min_price %>
          </p>
        </div>
      <% end %>

      <!-- ⭐ Rating -->
      <%
        avg_rating = product.average_rating

        rating_color =
          if avg_rating >= 4
            "bg-green-600"
          elsif avg_rating >= 3
            "bg-yellow-500"
          else
            "bg-red-500"
          end
      %>

      <div class="flex items-center gap-2">

        <!-- ⭐ Badge -->
        <div class="flex items-center gap-1
                    <%= rating_color %>
                    text-white px-2.5 py-1 rounded-lg
                    text-xs font-semibold shadow-sm
                    hover:scale-105 transition">

          <span>
            <%= number_with_precision(avg_rating, precision: 1) %>
          </span>

          <span class="text-[10px]">★</span>
          <span class="text-[10px]"> | </span>
          <span class="text-[10px]">
            <%= format_count(product.reviews.count) %>
          </span>
        </div>
      </div>
    </div>

    <!-- Variants -->
    <div class="text-xs text-gray-500 mb-4">
      <% product.product_variants.limit(2).each do |variant| %>
        <div class="flex justify-between">
          <span><%= variant.size %></span>
          <span>₹<%= variant.price %></span>
        </div>
      <% end %>
    </div>

    <!-- Actions -->
    <div class="flex justify-between items-center">
      <%= link_to "View", product_path(product),
        data: { turbo: false },
        class: "text-sm text-blue-600 hover:underline" %>

      <% variant = product.product_variants.first %>

      <%= button_to "Add",
        cart_items_path(product_variant_id: variant.id, quantity: 1),
        method: :post,
        form: { data: { turbo_stream: true } },
        class: "bg-pink-500 hover:bg-pink-600 text-white text-sm px-4 py-1 rounded-full shadow-md transition hover:scale-105 active:scale-95" %>
    </div>
  </div>
</div>
