<div class="max-w-7xl mx-auto px-4 py-8">

  <h1 class="text-3xl font-bold mb-8">
    🍰 Fresh from the oven
  </h1>
  <turbo-frame id="products">
    <div class="grid lg:grid-cols-4 gap-8">
      <!-- 🧭 FILTER SIDEBAR -->
      <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 h-fit sticky top-24">
        <%= render "filters" %>
      </div>

      <!-- 🛍️ PRODUCTS -->
      <div class="lg:col-span-3">
        <% if @products.any? %>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6" id="products_list">
            <%= render partial: "products_grid", locals: { products: @products } %>
            <%#= render partial: "product_card", collection: @products, as: :product %>

          </div>

        <% else %>

          <div class="flex flex-col items-center justify-center py-16 text-center">
            <div class="text-5xl mb-4">🔍</div>

            <h2 class="text-xl font-semibold mb-2">
              No products found
            </h2>

            <p class="text-gray-500 mb-4">
              No matching products for your filters
            </p>

            <%= link_to "Reset Filters", products_path,
              class: "bg-pink-500 text-white px-5 py-2 rounded-lg text-sm" %>
          </div>
        <% end %>
      </div>
    </div>
  </turbo-frame>

</div>


<style>
.chip {
  background: #ffe4e6;
  color: #db2777;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 12px;
}
</style>
