<div class="sticky top-24 space-y-6">

  <!-- 🧭 FILTER CARD -->
  <div class="p-6">

    <h2 class="text-lg font-semibold mb-6">Filters</h2>

    <%= form_with url: products_path,
        method: :get,
        data: { turbo_frame: "products" },
        class: "space-y-6" do %>

      <%= hidden_field_tag :query, params[:query] %>

      <!-- 📂 CATEGORY -->
      <div>
        <p class="text-sm font-medium mb-3 text-gray-700">Category</p>

        <div class="space-y-2">
          <% @categories.each do |cat| %>
            <label class="flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition
              <%= params[:category_id].to_s == cat.id.to_s ? "bg-pink-50 border border-pink-200" : "hover:bg-gray-50" %>">

              <span class="text-sm"><%= cat.name %></span>

              <%= radio_button_tag :category_id, cat.id,
                params[:category_id].to_s == cat.id.to_s,
                class: "accent-pink-500",
                onchange: "this.form.requestSubmit()" %>

            </label>
          <% end %>
        </div>
      </div>

      <!-- 🏷️ TAGS -->
      <div>
        <p class="text-sm font-medium mb-3 text-gray-700">Tags</p>

        <div class="flex flex-wrap gap-2">
          <% @tags.each do |tag| %>
            <% selected = params[:tag_ids]&.include?(tag.id.to_s) %>

            <label class="px-3 py-1.5 text-xs rounded-full cursor-pointer transition border
              <%= selected ? "bg-pink-500 text-white border-pink-500 shadow-sm" : "bg-gray-50 hover:bg-gray-100 border-gray-200" %>">

              <%= check_box_tag "tag_ids[]", tag.id, selected,
                class: "hidden",
                onchange: "this.form.requestSubmit()" %>

              <%= tag.name %>
            </label>
          <% end %>
        </div>
      </div>

      <!-- 💰 PRICE -->
      <div data-controller="price-slider">
        <p class="text-sm font-medium mb-3 text-gray-700">Price</p>

        <div class="flex justify-between text-xs text-gray-400 mb-2">
          <span>₹<span data-price-slider-target="minLabel"><%= params[:min_price] || 0 %></span></span>
          <span>₹<span data-price-slider-target="maxLabel"><%= params[:max_price] || 2000 %></span></span>
        </div>

        <div class="relative">
          <input type="range"
            min="0" max="2000" step="50"
            value="<%= params[:min_price] || 0 %>"
            data-price-slider-target="min"
            data-action="input->price-slider#update"
            class="w-full accent-pink-500">

          <input type="range"
            min="0" max="2000" step="50"
            value="<%= params[:max_price] || 2000 %>"
            data-price-slider-target="max"
            data-action="input->price-slider#update"
            class="w-full accent-pink-500 mt-2">
        </div>

        <%= hidden_field_tag :min_price, params[:min_price], data: { price_slider_target: "minInput" } %>
        <%= hidden_field_tag :max_price, params[:max_price], data: { price_slider_target: "maxInput" } %>
      </div>

      <!-- 🔽 SORT -->
      <div>
        <p class="text-sm font-medium mb-2 text-gray-700">Sort</p>

        <select name="sort"
          onchange="this.form.requestSubmit()"
          class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-pink-200">

          <option value="">Recommended</option>
          <option value="price_low" <%= "selected" if params[:sort]=="price_low" %>>
            Price: Low → High
          </option>
          <option value="price_high" <%= "selected" if params[:sort]=="price_high" %>>
            Price: High → Low
          </option>
          <option value="latest" <%= "selected" if params[:sort]=="latest" %>>
            Newest
          </option>
        </select>
      </div>

      <!-- ❌ CLEAR -->
      <div class="pt-2">
        <%= link_to "Clear Filters",
          products_path,
          class: "block text-center text-sm text-gray-500 hover:text-red-500 transition" %>
      </div>

    <% end %>

  </div>

</div>
