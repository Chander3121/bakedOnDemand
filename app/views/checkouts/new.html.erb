<div class="max-w-7xl mx-auto px-6 py-12 grid md:grid-cols-2 gap-10">

  <!-- 🧾 Address -->
  <div>
    <h2 class="font-semibold mb-4">Choose or Add Address</h2>

    <%= form_with url: checkout_path, method: :post do %>

      <!-- Saved addresses -->
      <div class="space-y-4 mb-6">
        <% current_user.addresses.each do |address| %>

          <label class="block border p-4 rounded-xl cursor-pointer">
            <%= radio_button_tag :address_id, address.id %>

            <div class="ml-2">
              <p class="font-medium"><%= address.name %></p>
              <p class="text-sm text-gray-500">
                <%= address.line1 %>, <%= address.city %>
              </p>
            </div>
          </label>

        <% end %>
      </div>

      <!-- Add new address -->
      <h3 class="font-semibold mb-2">Add New Address</h3>

      <div class="grid grid-cols-2 gap-3 mb-6">
        <%= text_field_tag "address[name]", nil, placeholder: "Name", class: "w-full border p-3 rounded-xl" %>
        <%= text_field_tag "address[phone]", nil, placeholder: "Phone", class: "w-full border p-3 rounded-xl" %>
        <%= text_field_tag "address[line1]", nil, placeholder: "Address", class: "w-full border p-3 rounded-xl col-span-2" %>
        <%= text_field_tag "address[city]", nil, placeholder: "City", class: "w-full border p-3 rounded-xl" %>
        <%= text_field_tag "address[state]", nil, placeholder: "State", class: "w-full border p-3 rounded-xl" %>
        <%= text_field_tag "address[pincode]", nil, placeholder: "Pincode", class: "w-full border p-3 rounded-xl col-span-2" %>
      </div>

      <%= submit_tag "Continue to Payment →",
        class: "mt-6 w-full bg-pink-500 text-white py-3 rounded-xl" %>

    <% end %>
  </div>

  <!-- 💰 Summary -->
  <div class="bg-white p-6 rounded-2xl shadow">
    <h2 class="font-semibold mb-4">Order Summary</h2>

    <% total = @cart.cart_items.sum { |i| i.quantity * i.product_variant.price } %>

    <div class="flex justify-between mb-2">
      <span>Subtotal</span>
      <span>₹<%= total %></span>
    </div>

    <div class="flex justify-between mb-4">
      <span>Delivery</span>
      <span class="text-green-600">Free</span>
    </div>

    <hr class="mb-4">

    <div class="flex justify-between font-bold text-lg">
      <span>Total</span>
      <span>₹<%= total %></span>
    </div>
  </div>

</div>